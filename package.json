{
  "name": "relay-webmcp",
  "version": "1.1.1",
  "packageManager": "pnpm@11.19.0",
  "description": "A browser-bound project workspace for human tasks, agent handoffs, and reviewed deliverables.",
  "private": true,
  "homepage": "https://relay.alx21.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/agammann/relay-webmcp.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app components lib types tests e2e",
    "format": "oxfmt",
    "test:e2e": "playwright test",
    "test:webmcp": "playwright test --config playwright.webmcp.config.ts",
    "package:release": "node scripts/package-release.mjs",
    "security:audit": "node scripts/audit-policy.mjs",
    "test:audit-policy": "node --test scripts/audit-policy.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20260930.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.145.0"
  },
  "type": "module"
}
